# filename: .env.example
# source this before running:  set -a; source .env; set +a

DISCORD_BOT_TOKEN=

# Only needed when llm.provider is "openrouter".
OPENROUTER_API_KEY=

# One webhook per voice. Discord: Channel → Edit Channel → Integrations →
# Webhooks → New Webhook → Copy Webhook URL.
WEBHOOK_BARNABY=
WEBHOOK_CASSANDRA=
WEBHOOK_RIVET=
WEBHOOK_MOTH=
WEBHOOK_DOC=
WEBHOOK_PIP=
WEBHOOK_HOLLIS=
WEBHOOK_NULL=

# Optional: webhook the conductor posts command acknowledgments through
# (!choir stop / start / status / mute ...). Leave empty and commands still
# apply and are logged, but nothing is echoed to the channel.
# Referenced by conductor.conductor_webhook_url in choir.yaml.
WEBHOOK_CONDUCTOR=
